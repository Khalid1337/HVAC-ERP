import axios from 'axios';
import '../styles/invoice.css';

interface Customer { id: string; name: string; }
interface InventoryItem { id: string; name: string; quantity: number; unit_cost: number; }
interface InvoiceLineItem { type: 'part' | 'service'; item_id: string; description: string; quantity: number; unit_price: number; }

export default function InvoiceCreator() {
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [inventory, setInventory] = useState<InventoryItem[]>([]);
  const [selectedCustomerId, setSelectedCustomerId] = useState('');
  const [lineItems, setLineItems] = useState<InvoiceLineItem[]>([]);
  const [warrantyTerms, setWarrantyTerms] = useState('1 week checking warranty');

  useEffect(() => {
    axios.get('/api/customers').then(res => setCustomers(res.data));
    axios.get('/api/inventory').then(res => setInventory(res.data));
  }, []);

  const addLineItem = () => {
    setLineItems([...lineItems, { type: 'part', item_id: '', description: '', quantity: 1, unit_price: 0 }]);
  };

  const handleItemChange = (index: number, field: keyof InvoiceLineItem, value: any) => {
    const updated = [...lineItems];
    updated[index] = { ...updated[index], [field]: value };
    
    if (field === 'item_id' && updated[index].type === 'part') {
      const matchingPart = inventory.find(p => p.id === value);
      if (matchingPart) {
        updated[index].unit_price = matchingPart.unit_cost * 1.5;
        updated[index].description = `HVAC Part: ${matchingPart.name}`;
      }
    }
    setLineItems(updated);
  };

  const handleSubmitInvoice = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedCustomerId || lineItems.length === 0) {
      alert("Please select a customer and add at least one item.");
      return;
    }

    try {
      const response = await axios.post('/api/invoices', {
        customer_id: selectedCustomerId,
        items: lineItems,
        status: 'unpaid',
        warranty_terms: warrantyTerms
      });
      alert(response.data.message);
      setLineItems([]);
      setSelectedCustomerId('');
    } catch (err: any) {
      alert("Transaction Error: " + (err.response?.data?.error || "Failed to save invoice."));
    }
  };

  const calculateTotal = () => lineItems.reduce((acc, item) => acc + (item.quantity * item.unit_price), 0);

  return (
    <div style={{ padding: '20px', backgroundColor: '#111', color: '#fff', borderTop: '2px solid #444', fontFamily: 'sans-serif' }}>
      <h2 style={{ color: '#ff9900' }}>📄 Create New Service Invoice</h2>
      <form onSubmit={handleSubmitInvoice} style={{ border: '1px solid #333', padding: '20px', borderRadius: '5px', backgroundColor: '#222' }}>
        
        <label style={{ display: 'block', marginBottom: '15px' }}>
          <strong>Select Customer Profile:</strong>
          <select value={selectedCustomerId} onChange={e => setSelectedCustomerId(e.target.value)} required style={{ display: 'block', width: '100%', padding: '10px', marginTop: '5px', background: '#333', color: '#fff' }}>
            <option value="">-- Choose Registered Customer --</option>
            {customers.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
        </label>

        <h3>🛠️ Service & Parts Billing Items</h3>
        {lineItems.map((item, index) => (
          <div key={index} style={{ display: 'flex', gap: '10px', marginBottom: '10px', alignItems: 'center' }}>
            <select value={item.type} onChange={e => handleItemChange(index, 'type', e.target.value)} style={{ padding: '8px', background: '#333', color: '#fff' }}>
              <option value="part">Physical Part</option>
              <option value="service">Labor/Service</option>
            </select>

            {item.type === 'part' ? (
              <select value={item.item_id} onChange={e => handleItemChange(index, 'item_id', e.target.value)} required style={{ padding: '8px', flex: 2, background: '#333', color: '#fff' }}>
                <option value="">-- Select Warehouse Part --</option>
                {inventory.map(p => <option key={p.id} value={p.id}>{p.name} (Available: {p.quantity})</option>)}
              </select>
            ) : (
              <input type="text" placeholder="Service Labor Description" value={item.description} onChange={e => handleItemChange(index, 'description', e.target.value)} required style={{ padding: '8px', flex: 2, background: '#333', color: '#fff' }} />
            )}

            <input type="number" placeholder="Qty" min="1" value={item.quantity} onChange={e => handleItemChange(index, 'quantity', parseInt(e.target.value) || 1)} style={{ padding: '8px', width: '60px', background: '#333', color: '#fff' }} />
            <input type="number" step="0.01" placeholder="Rate ($)" value={item.unit_price || ''} onChange={e => handleItemChange(index, 'unit_price', parseFloat(e.target.value) || 0)} style={{ padding: '8px', width: '100px', background: '#333', color: '#fff' }} />
          </div>
        ))}

        <button type="button" onClick={addLineItem} style={{ padding: '8px 15px', background: '#333', color: '#ff9900', border: '1px solid #ff9900', cursor: 'pointer', marginBottom: '20px' }}>+ Add Line Item</button>

        <div style={{ marginTop: '10px', padding: '10px', borderTop: '1px solid #444', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <h3>Grand Total: ${calculateTotal().toFixed(2)}</h3>
          <input type="text" value={warrantyTerms} onChange={e => setWarrantyTerms(e.target.value)} style={{ padding: '8px', background: '#333', color: '#fff', width: '250px', border: '1px solid #555' }} />
          <button type="submit" style={{ padding: '12px 25px', background: '#ff9900', color: '#000', border: 'none', fontWeight: 'bold', cursor: 'pointer', fontSize: '16px' }}>Save & Process Invoice</button>
        </div>
      </form>
    </div>
  );
}
