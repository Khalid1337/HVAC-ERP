{
  "name": "hvac-erp",
  "version": "1.0.0",
  "description": "HVAC ERP desktop management system",
  "author": "HVAC ERP",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "main": "electron/main.cjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test:server": "npm run test --workspace=server",
    "rebuild:electron": "electron-builder install-app-deps && electron-rebuild -f -w sqlite3 -v 44.3.0",
    "build:windows": "npm run build:client && npm run build:server && npm run rebuild:electron && electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0"
  },
  "build": {
    "appId": "com.hvac.erp",
    "productName": "HVAC ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "server/dist/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**/*",
      "node_modules/@mapbox/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
